<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="channel_chatgpt" model="discuss.channel" >
            <field name="name">Odoo AI</field>
            <field name="description">Odoo AI </field>
            <field name="image_128" type="base64" file="odoo_ai_chat/static/description/gemin.png"/>
        </record>

        <record  id="module_install_notification" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="odoo_ai_chat.channel_chatgpt"/>
            <field name="message_type">email</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to Odoo AI  Channel!</field>
            <field name="body"><![CDATA[<p>Welcome to the #Odoo AI  channel.</p>
            <p>Ask your questions to Odoo AI </b>.</p>]]></field>
        </record>

        <record model="discuss.channel.member" id="channel_member_chatgtp_channel_for_admin">
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="channel_id" ref="odoo_ai_chat.channel_chatgpt"/>
            <field name="fetched_message_id" ref="odoo_ai_chat.module_install_notification"/>
            <field name="seen_message_id" ref="odoo_ai_chat.module_install_notification"/>
        </record>

    </data>
</odoo>
